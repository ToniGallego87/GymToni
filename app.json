{
  "expo": {
    "name": "GymBro",
    "slug": "gymbro",
    "icon": "./assets/icon.png",
    "version": "0.6.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tonigallego.gymbro"
    },
    "android": {
      "package": "com.tonigallego.gymbro",
      "permissions": [],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "transparent",
      "barStyle": "light-content",
      "translucent": true
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#F9A825"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-router",
        {
          "origin": false,
          "asyncRoutes": true,
          "root": "./app"
        }
      ]
    ],
    "scheme": "gymbro",
    "extra": {
      "eas": {
        "projectId": "66ab349f-bf74-4fa9-b4af-263fc087d9b5"
      }
    }
  }
}
