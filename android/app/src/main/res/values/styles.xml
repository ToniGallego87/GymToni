<resources xmlns:tools="http://schemas.android.com/tools">
  <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
    <item name="android:textColor">@android:color/black</item>
    <item name="android:editTextStyle">@style/ResetEditText</item>
    <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <!-- Fondo de la ventana = el MISMO dibujo del splash (negro + titular). El
         de AppCompat Light es blanco y asomaba como un fogonazo entre el
         splash y la app; negro liso, sin el titular, se leía como un parpadeo.
         Así, en cualquier hueco entre capas se sigue viendo el splash. La app
         lo tapa entero (su raíz tiene fondo propio). -->
    <item name="android:windowBackground">@drawable/splashscreen</item>
  </style>
  <!-- Igual que AppTheme con el splash en blanco: lo pone MainActivity cuando
       la app va a arrancar en modo claro (tema guardado). -->
  <style name="AppTheme.Light">
    <item name="android:windowBackground">@drawable/splashscreen_light</item>
  </style>
  <style name="ResetEditText" parent="@android:style/Widget.EditText">
    <item name="android:padding">0dp</item>
    <item name="android:textColorHint">#c8c8c8</item>
    <item name="android:textColor">@android:color/black</item>
  </style>
  <!-- Splash del sistema (API de Android 12, la que usa expo-splash-screen):
       negro y SIN icono. Su icono se recorta en un círculo de 192 dp, donde el
       titular solo cabe enano; por eso MainActivity lo suelta en cuanto la
       Activity pinta y el titular lo pone AppTheme (windowBackground) a su
       tamaño, con la copia en JS encima (components/SplashFade.tsx). -->
  <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@color/splashscreen_background</item>
    <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    <item name="postSplashScreenTheme">@style/AppTheme</item>
    <item name="android:windowSplashScreenBehavior">icon_preferred</item>
  </style>
  <!-- El del sistema en blanco. Android 13+ lo usa en el siguiente arranque
       cuando MainActivity lo pide (setSplashScreenTheme) por estar la app en
       modo claro. En Android 12 o menos, y en 13+ en el primer arranque tras
       instalar, actualizar o forzar el cierre, el sistema pinta el negro de
       arriba: en modo claro asoma un instante negro antes del blanco de la
       ventana (AppTheme.Light). No hay forma de evitarlo: el sistema lo pinta
       antes de que exista la app. -->
  <style name="Theme.App.SplashScreen.Light">
    <item name="windowSplashScreenBackground">@color/splashscreen_background_light</item>
    <item name="postSplashScreenTheme">@style/AppTheme.Light</item>
  </style>
</resources>
